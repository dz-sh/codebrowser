{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dz-sh/codebrowser/codebrowser.schema.json",
  "title": "Code Browser repository build descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "repository", "views"],
  "properties": {
    "version": {
      "const": 1
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "source": {
          "$ref": "#/$defs/relativePath"
        }
      }
    },
    "views": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/view"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "(^/|(^|/)\\.\\.(/|$))"
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build", "compilation_database"],
      "properties": {
        "build": {
          "type": "object",
          "additionalProperties": false,
          "required": ["root", "path"],
          "properties": {
            "root": {
              "enum": ["source", "build"]
            },
            "path": {
              "$ref": "#/$defs/relativePath"
            }
          }
        },
        "compilation_database": {
          "$ref": "#/$defs/relativePath"
        },
        "built_commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40,64}$"
        }
      }
    }
  }
}
