# Absolute host paths. Code Browser mounts them read-only at the same paths.
SOURCE_ROOT=/srv/workspace/source
BUILD_ROOT=/srv/workspace/build

CODEBROWSER_PORT=8080
CODEBROWSER_UID=1000
CODEBROWSER_GID=1000

# latest is published only by a stable GitHub Release. Override it to pin a
# release or immutable sha-* image tag.
CODEBROWSER_IMAGE=ghcr.io/dz-sh/codebrowser:latest
